BUILDDIR=build
CMAKEDIR=../CMake
all:
	rm -rf "$(BUILDDIR)"
	mkdir -p "$(BUILDDIR)"
	cd "$(BUILDDIR)" && CC="@CC@" CFLAGS="@CFLAGS@" CPPFLAGS="@CPPFLAGS@" LDFLAGS="@LDFLAGS@" cmake -DCMAKE_BUILD_TYPE=Release "-DCMAKE_INSTALL_PREFIX=@libdir@" -DCMAKE_INSTALL_LIBDIR=. "$(CMAKEDIR)" && cmake --build .
install:
	cd "$(BUILDDIR)" && cmake --build . --target install
